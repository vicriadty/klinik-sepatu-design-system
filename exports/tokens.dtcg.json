{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Editorial monochrome design system for a mobile-first shoe-care workshop decision and learning experience.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.063,
          0.063
        ],
        "hex": "#101010"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.357,
          0.357,
          0.337
        ],
        "hex": "#5b5b56"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.42,
          0.271
        ],
        "hex": "#176b45"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.949
        ],
        "hex": "#f5f5f2"
      }
    },
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.788,
          0.788,
          0.769
        ],
        "hex": "#c9c9c4"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.639,
          0.129,
          0.129
        ],
        "hex": "#a32121"
      }
    },
    "notice": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.463,
          0.357,
          0
        ],
        "hex": "#765b00"
      }
    }
  },
  "spacing": {
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "16": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "$type": "dimension"
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "card": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif",
        "fontSize": {
          "value": 3.5,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.045,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.035,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 750,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 750
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    }
  }
}
